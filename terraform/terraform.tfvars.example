aws_region   = "us-east-1"
project_name = "rowbot"
environment  = "production"

github_repository = "yourusername/ergracer" # owner/repo, for the GitHub Actions OIDC trust policy

# Pick a tag that's already been pushed to ECR (see the updated
# .github/workflows/docker-publish.yml). No default on purpose.
image_tag = "v1.0.0"

# Update after the first apply, once you have the ALB's DNS name from
# `terraform output alb_dns_name` — must exactly match the scheme+host the
# app is actually reachable at, since it's used for OAuth redirect URIs.
app_base_url = "http://CHANGE_ME_AFTER_FIRST_APPLY.us-east-1.elb.amazonaws.com"

# Leave both blank until you have a real domain — see the HTTPS/cookie
# warning in alb.tf before going further without one.
domain_name     = ""
route53_zone_id = ""
